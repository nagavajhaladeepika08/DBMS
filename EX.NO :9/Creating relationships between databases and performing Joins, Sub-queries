8.5 Display students who scored more than 80
SELECT s.student_name, c.course_name, e.marks
FROM Enrollment e
JOIN Student s ON e.student_id = s.student_id
JOIN Course c ON e.course_id = c.course_id
WHERE e.marks > 80;
