8. SQL Queries – Relationships and JOINs
8.1 Display students with their department names
SELECT s.student_id, s.student_name, d.dept_name
FROM Student s
INNER JOIN Department d
    ON s.dept_id = d.dept_id;
Expected result:
student_id	student_name	dept_name
101	Anu	CSE
102	Bala	CSE
103	Charan	ECE
104	Divya	IT

8.2 Display all students, including students without a department
SELECT s.student_id, s.student_name, d.dept_name
FROM Student s
LEFT JOIN Department d
    ON s.dept_id = d.dept_id;
Expected result:
student_id	student_name	dept_name
101	Anu	CSE
102	Bala	CSE
103	Charan	ECE
104	Divya	IT
105	Esha	NULL

8.3 Display all departments and their students
SELECT d.dept_id, d.dept_name, s.student_name
FROM Department d
LEFT JOIN Student s
    ON d.dept_id = s.dept_id
ORDER BY d.dept_id;
Expected result:
dept_id	dept_name	student_name
10	CSE	Anu
10	CSE	Bala
20	ECE	Charan
30	IT	Divya
40	MECH	NULL

8.4 Display students and the courses they enrolled in
SELECT s.student_name, c.course_name, e.marks
FROM Enrollment e
INNER JOIN Student s ON e.student_id = s.student_id
INNER JOIN Course c ON e.course_id = c.course_id
ORDER BY s.student_id;
