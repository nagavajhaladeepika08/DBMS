 Sample Queries
1 Count total number of employees
SELECT COUNT(*) AS TotalEmployees FROM Employee;
2 Total salary paid by the company
SELECT SUM(Salary) AS TotalSalary FROM Employee;
3 Average salary of employees
SELECT AVG(Salary) AS AverageSalary FROM Employee;
4 Highest and lowest salary
SELECT MAX(Salary) AS HighestSalary, MIN(Salary) AS LowestSalary FROM Employee;
5 Number of employees in each department (GROUP BY)
SELECT Department, COUNT(*) AS EmpCount
FROM Employee
GROUP BY Department;
6 Average salary department-wise
SELECT Department, AVG(Salary) AS AvgSalary
FROM Employee
GROUP BY Department
ORDER BY AvgSalary DESC;
7 Departments with more than 3 employees (HAVING)
SELECT Department, COUNT(*) AS EmpCount
FROM Employee
GROUP BY Department
HAVING COUNT(*) > 3;.

8 Departments where average salary exceeds 50000
SELECT Department, AVG(Salary) AS AvgSalary
FROM Employee
GROUP BY Department
HAVING AVG(Salary) > 50000;
9 Combining WHERE, GROUP BY and HAVING
SELECT Department, City, COUNT(*) AS EmpCount
FROM Employee
WHERE Salary > 40000
GROUP BY Department, City
HAVING COUNT(*) >= 2
ORDER BY Department;

10 City-wise total salary expenditure (only cities spending above 1,00,000)
SELECT City, SUM(Salary) AS TotalSalary
FROM Employee
GROUP BY City
HAVING SUM(Salary) > 100000;
